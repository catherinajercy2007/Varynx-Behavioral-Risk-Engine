# Varynx Environment Configuration
# Copy to .env and fill in real values before deployment.
# NEVER commit .env to version control.

# =============================================================
# REQUIRED
# =============================================================

# PostgreSQL connection URL.
# Use memory://dev for local development without a database.
# VARYNX_DATABASE_URL=memory://dev
VARYNX_DATABASE_URL=postgresql://varynx:CHANGE_ME@localhost:5432/varynx

# =============================================================
# AUTHENTICATION (required for protected deployments)
# =============================================================

# API key that clients must send as X-API-Key header.
# Leave unset for local development (auth disabled with logged warning).
# VARYNX_API_KEY=

# Set to true in production to refuse startup when VARYNX_API_KEY is missing.
# VARYNX_REQUIRE_API_KEY=true

# =============================================================
# CORS (adjust to your actual frontend origin in production)
# =============================================================

VARYNX_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Production example:
# VARYNX_CORS_ORIGINS=https://your-dashboard.example.com

# =============================================================
# AWS INTEGRATIONS (all optional — LOCAL_MODE when unset)
# =============================================================

# AWS_REGION=us-east-1

# CloudWatch metrics
# VARYNX_AWS__CLOUDWATCH_ENABLED=false
# VARYNX_AWS__CLOUDWATCH_NAMESPACE=Varynx/SecurityEngine

# S3 artifact export
# VARYNX_AWS__S3_ENABLED=false
# VARYNX_AWS__S3_BUCKET=

# CloudTrail event ingestion
# VARYNX_AWS__CLOUDTRAIL_ENABLED=false

# =============================================================
# OPTIONAL
# =============================================================

# Redis URL (event replay cache — not required for in-memory mode)
# VARYNX_REDIS_URL=redis://localhost:6379/0

# Dry-run mode: log enforcement actions without applying them
# VARYNX_DRY_RUN_MODE=false

# =============================================================
# DASHBOARD (dashboard/.env.local)
# =============================================================

# These go in dashboard/.env.local, not here.
# NEXT_PUBLIC_VARYNX_API_URL=http://127.0.0.1:8000/api/v1
# NEXT_PUBLIC_VARYNX_API_KEY=    (only if VARYNX_API_KEY is set)