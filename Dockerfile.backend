
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY . .

RUN pip install --no-cache-dir .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD-SHELL python -c "import os, urllib.request; port=os.getenv('PORT', '8000'); urllib.request.urlopen('http://127.0.0.1:' + port + '/api/v1/health', timeout=5)"

CMD ["sh", "-c", "uvicorn varynx.api.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
